# =============================================================================
#  Hermes — environment template
# =============================================================================
#  Copy this file to `.env` (same directory as docker-compose.yml) and fill in
#  the two values marked "FILL IN BY HAND". Everything else has a working
#  default and only needs touching if you have a port conflict or a strong
#  opinion.
#
#      cp .env.example .env         # or:  make bootstrap
#
#  `make bootstrap` does the copy AND generates ENCRYPTION_KEY for you, so you
#  are left with exactly one manual value (FREELLMAPI_KEY), which you cannot
#  get until the router is running.
#
#  .env is git-ignored. Never commit it. It is also excluded from `make ship`.
#
#  Legend:
#     [FILL IN]  you must provide this by hand; the stack will not work without it
#     [AUTO]     `make bootstrap` generates it
#     [DEFAULT]  fine as-is; change only if you need to
#     [FIXED]    an in-container path or URL; changing it breaks service wiring
# =============================================================================


# -----------------------------------------------------------------------------
# Network exposure
# -----------------------------------------------------------------------------
# [DEFAULT] Host interface that published ports bind to.
#
# 127.0.0.1 means "this machine only" and is the right answer for a personal
# tool that holds your LinkedIn session cookies, your resume and an LLM router
# containing provider API keys. Set it to 0.0.0.0 only if you deliberately want
# the dashboard reachable from your LAN, and understand that there is NO
# authentication in front of any of these services.
HOST_BIND=127.0.0.1


# -----------------------------------------------------------------------------
# freellmapi — the self-hosted OpenAI-compatible LLM router
# -----------------------------------------------------------------------------
# [FILL IN] ==> [AUTO if you run `make bootstrap`]
#
# 64 hexadecimal characters (32 bytes). freellmapi uses this to encrypt the
# provider API keys it stores in its own volume. Generate one with ANY of:
#
#     make bootstrap
#     openssl rand -hex 32
#     python -c "import secrets; print(secrets.token_hex(32))"
#     powershell -c "-join ((1..32) | %{ '{0:x2}' -f (Get-Random -Max 256) })"
#
# WARNING: changing this value after freellmapi has stored provider keys makes
# those stored keys undecryptable. You would have to re-add them in its
# dashboard. Back it up together with the freellmapi-data volume.
ENCRYPTION_KEY=

# [FIXED] How hermes-core reaches the router, over the compose network.
# `freellmapi` is the compose service name; port 3001 is internal. Do not
# change this to localhost — inside hermes-core, localhost is hermes-core.
FREELLMAPI_BASE_URL=http://freellmapi:3001/v1

# [FILL IN] Client bearer token for the router. Looks like:  freellmapi-xxxxxxxx
#
# This CANNOT be generated offline — it is minted inside freellmapi's own web
# dashboard. Get it like this:
#     1.  make up
#     2.  open  http://127.0.0.1:3001
#     3.  add at least one free provider key (Groq / Gemini / OpenRouter / ...)
#     4.  create an API key / client token in that dashboard
#     5.  paste it below (keep the `freellmapi-` prefix)
#     6.  make restart
#
# Until this is set, hermes-core starts fine but every LLM-backed feature
# (profile analysis, resume writing, semantic ATS pass, match ranking) fails
# with a clear configuration error. Job search and the deterministic ATS
# scorer still work.
FREELLMAPI_KEY=

# [DEFAULT] Published port for the router's dashboard on the host.
FREELLMAPI_PORT=3001


# -----------------------------------------------------------------------------
# Model selection
# -----------------------------------------------------------------------------
# [DEFAULT] Preferred model id, exactly as it appears in GET /v1/models on the
# router (visible in the dashboard's Settings page).
#
# Leave BLANK to let hermes-core auto-pick from the router's advertised model
# list at startup. Set it explicitly once you know which free model your
# provider mix actually serves reliably.
#
# Examples:  gemini-2.5-flash  |  llama-3.3-70b-versatile  |  qwen-2.5-72b-instruct
HERMES_MODEL_PRIMARY=

# [DEFAULT] Comma-separated failover chain, tried in order when the primary
# returns 429 / 5xx / times out. Free tiers rate-limit aggressively, so listing
# two or three alternatives from *different* upstream providers is the single
# highest-value tuning you can do here.
#
# Example:  HERMES_MODEL_FALLBACKS=llama-3.3-70b-versatile,gemini-2.0-flash,mistral-small-latest
HERMES_MODEL_FALLBACKS=


# -----------------------------------------------------------------------------
# LinkedIn MCP server
# -----------------------------------------------------------------------------
# [FIXED] In-network URL of the MCP streamable-http endpoint. Must match the
# --host/--port/--path flags in docker-compose.yml.
LINKEDIN_MCP_URL=http://linkedin-mcp:8000/mcp

# [DEFAULT] Host port for the one-shot interactive-login viewer (noVNC).
# Only in use while `make login-linkedin` is running. Open
# http://127.0.0.1:6080/vnc.html and log in with your own hands — Hermes never
# types your LinkedIn credentials for you and never stores them.
LINKEDIN_VIEWER_PORT=6080


# -----------------------------------------------------------------------------
# Hermes services
# -----------------------------------------------------------------------------
# [DEFAULT] Host port for the hermes-core FastAPI app (http://127.0.0.1:8080/api/health).
HERMES_API_PORT=8080

# [DEFAULT] Host port for the dashboard (http://127.0.0.1:3000). This is the
# one you actually open day to day.
HERMES_DASHBOARD_PORT=3000


# -----------------------------------------------------------------------------
# Sandbox (ephemeral containers spawned by hermes-core)
# -----------------------------------------------------------------------------
# Untrusted work — LLM-authored Python, resume rendering via python-docx and
# LibreOffice — runs in a throwaway container, not in hermes-core itself.

# [DEFAULT] Image tag that hermes-core spawns. Produced by
# `docker compose --profile build-only build` (i.e. `make build`).
# Namespaced on purpose: a bare `hermes-sandbox:latest` is a common tag and
# would silently overwrite an unrelated local image of the same name.
HERMES_SANDBOX_IMAGE=hermes-linkedin/sandbox:latest

# [DEFAULT] Hard memory cap per sandbox container, in MB. LibreOffice headless
# conversion is the memory-hungry step; below ~768 it starts failing.
HERMES_SANDBOX_MEMORY_MB=1024

# [DEFAULT] CPU quota per sandbox container (1.0 = one full core).
HERMES_SANDBOX_CPUS=1.0

# [DEFAULT] Wall-clock timeout in seconds. The container is killed at this
# point and the run is recorded as failed.
HERMES_SANDBOX_TIMEOUT_S=300

# [DEFAULT] Docker network for sandbox containers. "none" disables networking
# entirely and is strongly recommended: nothing Hermes runs in a sandbox has
# any legitimate reason to reach the internet or the compose network.
HERMES_SANDBOX_NETWORK=none

# [FIXED] Directory *inside the containers* holding per-run workspaces. It lives
# under HERMES_DATA_DIR so it is on the hermes-data volume, which is what makes
# it visible to both hermes-core and the sandbox container it spawns.
HERMES_SANDBOX_WORKSPACE=/data/workspaces


# -----------------------------------------------------------------------------
# Storage & Docker access
# -----------------------------------------------------------------------------
# [FIXED] Data root inside hermes-core: SQLite DB (hermes.db), rendered
# resumes, sandbox workspaces. Backed by the hermes-data volume. This is a
# CONTAINER path — do not put a Windows path here.
HERMES_DATA_DIR=/data

# [FIXED] How hermes-core talks to the Docker daemon. The socket is bind-mounted
# into the container by docker-compose.yml.
#
# Docker socket access is effectively host root. Read the long comment above the
# mount in docker-compose.yml before exposing this stack to anything other than
# loopback. To point at a socket proxy instead, set e.g.
#     HERMES_DOCKER_HOST=tcp://docker-socket-proxy:2375
# and remove the socket mount from docker-compose.yml.
HERMES_DOCKER_HOST=unix:///var/run/docker.sock


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# [DEFAULT] DEBUG | INFO | WARNING | ERROR. Applies to hermes-core and to the
# LinkedIn MCP server. DEBUG on linkedin-mcp is genuinely useful when a scrape
# starts returning empty sections.
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# CORS (optional)
# -----------------------------------------------------------------------------
# [OPTIONAL] Comma-separated extra browser origins allowed to call the hermes-core
# API. The dashboard origin is allowed automatically, so leave this blank unless
# you are running the Vite dev server (npm run dev on :5173) against the
# containerised API, or reaching the dashboard from another device on your LAN.
#   HERMES_EXTRA_CORS_ORIGINS=http://localhost:5173,http://192.168.1.50:3000
HERMES_EXTRA_CORS_ORIGINS=
